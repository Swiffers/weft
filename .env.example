# ===========================================
# Weft Environment Configuration
# ===========================================
# Copy this to .env and customize for your setup. The weft CLI loads
# the nearest .env up from the invoking directory; real environment
# variables win over it.
#
# Two levels, when you work in several worktrees:
#   .env        shared: scripts/add-worktree.sh links the main checkout's
#               one into every worktree, so a key you add is everywhere.
#   .env.local  this checkout only: never linked, never committed. Loaded
#               from the same folder as .env, and wins over it (real
#               environment variables still win over both). A setting
#               that must differ per checkout goes here, the public
#               tunnel below above all: two installs started on one
#               tunnel token would split its traffic between them.

# ----- Provider keys -----
# The runtime's own provider credentials do NOT live in env vars: they
# are `api_key` entries in the shared-credentials file (see
# access-apps.example.json), next to the OAuth apps. Edits to that file
# take effect without a restart.

# ----- Credential sealing -----
# AES-256-GCM key sealing stored connection credentials at rest in
# Postgres. Generate with: openssl rand -base64 32
# If not set, a built-in development key is used and a warning is
# logged: fine for local tinkering, set a real key before storing
# credentials you care about. Changing the key strands every sealed
# row (reconnect the affected connections).
# CREDENTIAL_ENCRYPTION_KEY=

# ----- Registered OAuth apps -----
# Path to the registered-apps file (client ids + secrets for the
# services users may connect through your apps). Defaults to
# access-apps.json in the working directory; see access-apps.example.json.
# WEFT_ACCESS_APPS_FILE=

# ----- Logging -----
# RUST_LOG=info

# Stable public address: a Cloudflare named tunnel under your own domain
# (docs/src/build/public-address.md, "A stable address of your own"). Unset = a free quick tunnel with a RANDOM
# address that changes on every reconnect. These two lines belong in the
# checkout's .env.local, not here: each checkout's install opens its own
# tunnel, and a token shared through .env would reach every worktree.
# WEFT_PUBLIC_TUNNEL_TOKEN=
# WEFT_PUBLIC_TUNNEL_HOSTNAME=

# ----- Node-test live tier (docs/node-tests.md) -----
# Keys stand in for a stored connection (WEFT_NODE_TEST_<SERVICE>_<FIELD>);
# the rest are the fixtures live tests declare.
WEFT_NODE_TEST_OPENROUTER_KEY=
WEFT_NODE_TEST_OPENAI_KEY=
WEFT_NODE_TEST_ELEVENLABS_KEY=
WEFT_NODE_TEST_FAL_KEY=
WEFT_NODE_TEST_EXA_KEY=
WEFT_NODE_TEST_FIRECRAWL_KEY=
WEFT_NODE_TEST_MISTRAL_KEY=
WEFT_NODE_TEST_TELEGRAM_TOKEN=
WEFT_NODE_TEST_GITHUB_TOKEN=
WEFT_NODE_TEST_EMAIL_USER=
WEFT_NODE_TEST_EMAIL_PASSWORD=
WEFT_NODE_TEST_EMAIL_IMAP_HOST=
WEFT_NODE_TEST_EMAIL_IMAP_PORT=
WEFT_NODE_TEST_EMAIL_SMTP_HOST=
WEFT_NODE_TEST_EMAIL_SMTP_PORT=
WEFT_NODE_TEST_S3_ENDPOINT=
WEFT_NODE_TEST_S3_REGION=
WEFT_NODE_TEST_S3_ACCESS_KEY_ID=
WEFT_NODE_TEST_S3_SECRET_ACCESS_KEY=
WEFT_NODE_TEST_S3_BUCKET=
WEFT_NODE_TEST_EMAIL_TO=
WEFT_NODE_TEST_GMAIL_TO=
WEFT_NODE_TEST_GITHUB_REPO=
WEFT_NODE_TEST_GOOGLE_SHEET_ID=
WEFT_NODE_TEST_GOOGLE_DOC_ID=
WEFT_NODE_TEST_SLACK_CHANNEL_ID=
WEFT_NODE_TEST_TELEGRAM_CHAT_ID=
