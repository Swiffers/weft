# A file that appears in a folder on this machine fires a run. The run reads
# the file itself and says which folder it runs in: on a local install the
# worker is a process on the machine, in the project's folder.

watch = FolderWatch { folder: "/__E2E_FOLDER__", events: ["created"] }
read = ExecPython(path: String) -> (text: String, cwd: String) {
  code: "import os\nreturn {'text': open(path).read(), 'cwd': os.getcwd()}"
}
read.path = watch.path
text = Debug
text.data = read.text
cwd = Debug
cwd.data = read.cwd
