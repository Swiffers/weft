# Two routes. `front` answers on its own; `back` answers through the file
# `lib/stage.weft`. The test breaks that file, the way another person
# editing it mid-change does: `front` still activates and answers, and
# `back` is refused, naming the file.
#
#   POST front   answers {"heard": <text>}
#   POST back    answers {"heard": <TEXT>}, shaped inside lib/stage.weft

front = Route -> (body: { text?: String, .. }) { path: "__E2E_PATH__/front", method: "POST" }
front_body = ExecPython(text: String) -> (body: JsonDict) {
  code: "return {'body': {'heard': text}}"
}
front_body.text = front.body.text
front_answer = Reply
front_answer.body = front_body.body

back = Route -> (body: { text?: String, .. }) { path: "__E2E_PATH__/back", method: "POST" }
stage = @include("lib/stage.weft")
stage.text = back.body.text
back_answer = Reply
back_answer.body = stage.body

# Read at compile, so a command's snapshot holds it.
note = Text { value: @file("prompts/note.md") }
