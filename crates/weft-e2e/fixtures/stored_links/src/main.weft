# Stored files served to a page, and a page's upload. The rig calls each
# route and follows the links it gets.
#
#   GET  file     the project's stored file (an @asset), answered as JSON:
#                 { url, mimeType, filename, sizeBytes }, the url a link
#                 straight to the bytes the rig asks any part of
#   GET  slot     a slot a page uploads one file through
#   POST receive  { doc: "weft-upload:..." }: the file the page uploaded
#                 through that slot, received once, answered as its text

file = Route { path: "__E2E_PATH__/file", method: "GET" }
pick = ExecPython(doc: Blob) -> (out: Blob) {
  code: "return {'out': doc}"
  doc: @asset("assets/clip.txt", Blob)
}
pick._should_flow = file.fired
send = Reply
send.body = pick.out

slot = Route { path: "__E2E_PATH__/slot", method: "GET" }
grant = UploadSlot { maxMb: 1, types: "File", minutes: 10, scope: "run" }
grant._should_flow = slot.fired
hand = Reply
hand.body = grant.slot

receive = Route -> (body: { doc: Blob }) { path: "__E2E_PATH__/receive", method: "POST" }
read = FileToText
read.file = receive.body.doc
said = Reply
said.body = read.text
