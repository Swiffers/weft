# Streaming with zero custom Rust: a bus producer (a fixture node standing in
# for an LLM stream) feeds a Stream node behind a route, once framed as
# server-sent events and once as ndjson. The rig reads each response whole and
# asserts the content type and the exact frames. Then the ways a producer
# fails: before its first piece with nothing handling it, before its first
# piece with a backup branch gated on its `_error`, and halfway through.

sse = Route { path: "__E2E_PATH__/sse", method: "GET" }
ticks = TickBus
ticks.start = sse.path
events = Stream { format: "sse" }
events.bus = ticks.ticks

lines = Route { path: "__E2E_PATH__/lines", method: "GET" }
ticks2 = TickBus
ticks2.start = lines.path
rows = Stream { format: "ndjson", headers: { "x-run": "e2e" } }
rows.bus = ticks2.ticks

# A feed that says one thing and then goes quiet. The rig reads the
# first event, hangs up, and asserts the run is cancelled: a caller who
# left is found without the program writing anything.
quiet = Route { path: "__E2E_PATH__/quiet", method: "GET" }
silence = QuietBus
silence.start = quiet.path
feed = Stream { format: "sse" }
feed.bus = silence.feed

# The producer fails before its bus opens and nothing handles it: the run
# fails without answering, and the caller is told so plainly.
refused = Route { path: "__E2E_PATH__/refused", method: "GET" }
early = TickBus { failAt: 0 }
early.start = refused.path
lost = Stream { format: "sse" }
lost.bus = early.ticks

# The same failure caught: no bus opened, so the stream never starts, and
# the branch gated on `_error` answers instead.
backup = Route { path: "__E2E_PATH__/backup", method: "GET" }
flaky = TickBus { failAt: 0 }
flaky.start = backup.path
primary = Stream { format: "sse" }
primary.bus = flaky.ticks
fallback = Reply { body: "the backup answered" }
fallback._should_flow = flaky._error

# The producer breaks off after two pieces: what went out stays sent, and
# the stream ends with its format's error marker.
broken = Route { path: "__E2E_PATH__/broken", method: "GET" }
halfway = TickBus { failAt: 2 }
halfway.start = broken.path
cut = Stream { format: "sse" }
cut.bus = halfway.ticks
