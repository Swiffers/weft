  {
    "drive_changes": {
      "fields": {
        "changed": "header:X-Goog-Changed",
        "messageNumber": "header:X-Goog-Message-Number",
        "resource": "header:X-Goog-Resource-Id",
        "resourceUri": "header:X-Goog-Resource-URI",
        "state": "header:X-Goog-Resource-State"
      },
      "account": {
        "value": "userEmail",
        "path": "header:X-Goog-Channel-Token"
      },
      "webhook": {
        "idPath": "header:X-Goog-Channel-ID",
        "tokenPath": "header:X-Goog-Channel-Token",
        "verify": {
          "kind": "token_echo"
        },
        "routeBy": "subscription",
        "subscribe": {
          "subscribe": {
            "url": "https://www.googleapis.com/drive/v3/files/{target}/watch?supportsAllDrives=true",
            "method": "POST",
            "body": {
              "id": "{subscriptionId}",
              "type": "web_hook",
              "address": "{receiverUrl}",
              "token": "{subscriptionToken}"
            },
            "auth": [
              {
                "kind": "header",
                "name": "Authorization",
                "value": "Bearer {token}"
              }
            ],
            "captures": [
              {
                "name": "expiresAt",
                "path": "expiration",
                "optional": false
              },
              {
                "name": "resourceId",
                "path": "resourceId",
                "optional": false
              }
            ]
          },
          "unsubscribe": {
            "url": "https://www.googleapis.com/drive/v3/channels/stop",
            "method": "POST",
            "body": {
              "id": "{subscriptionId}",
              "resourceId": "{resourceId}"
            },
            "auth": [
              {
                "kind": "header",
                "name": "Authorization",
                "value": "Bearer {token}"
              }
            ]
          },
          "renewMarginSecs": 600
        }
      }
    }
  },
  {
    "payments": {
      "fields": {
        "type": "type"
      },
      "account": {
        "value": "accountId",
        "path": "account"
      },
      "webhook": {
        "eventPath": "data.object",
        "verify": {
          "kind": "hmac",
          "concat": "{timestamp}.{body}",
          "signatureHeader": "Stripe-Signature",
          "packed": {
            "timestamp": "t",
            "signature": "v1"
          }
        },
        "routeBy": "account"
      }
    }
  }
